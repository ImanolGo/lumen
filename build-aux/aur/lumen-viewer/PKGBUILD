# Maintainer: Imanol Gomez <imanol@steinergomez.com>
# The project is Lumen, but the package is `lumen-viewer`: `lumen` is another program on the
# AUR, and both would install /usr/bin/lumen. The binary is installed as `lumen-viewer`.
pkgname=lumen-viewer
_pkgname=lumen
pkgver=0.4.2
pkgrel=1
pkgdesc='Fast image and PDF viewer with light editing, markup and page management'
arch=('x86_64' 'aarch64')
url='https://github.com/ImanolGo/lumen'
license=('GPL-3.0-or-later')
depends=('gtk4>=4.16' 'libadwaita>=1.8' 'poppler-glib>=25.06' 'glib2' 'cairo' 'glycin' 'libseccomp')
makedepends=('cargo' 'gettext')
checkdepends=('desktop-file-utils' 'appstream')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# After each new tag: `updpkgsums`, then `makepkg --printsrcinfo > .SRCINFO`.
sha256sums=('ae9a8d79eafa8b551b26653bdd1f99c05ff9c3827685e9c69d6be16e2b4242ed')

prepare() {
    cd "$_pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "$_pkgname-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    make build translations
}

check() {
    cd "$_pkgname-$pkgver"
    desktop-file-validate data/io.github.imanolgo.Lumen.desktop
    appstreamcli validate --no-net data/io.github.imanolgo.Lumen.metainfo.xml
}

package() {
    cd "$_pkgname-$pkgver"
    make install-files DESTDIR="$pkgdir" PREFIX=/usr
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
