# Maintainer: ImanolGo (https://github.com/ImanolGo/lumen)
#
# Builds a tagged release. Before submitting: tag the release (vX.Y.Z), then run
# `updpkgsums` here and `makepkg --printsrcinfo > .SRCINFO`.
pkgname=lumen-viewer
pkgver=0.10.0
pkgrel=1
pkgdesc='A fast, safe viewer and editor for pictures and PDFs, in pure Rust with iced'
arch=('x86_64')
url='https://github.com/ImanolGo/lumen'
license=('GPL-3.0-or-later')
# The window system and the GPU driver are loaded when the program starts, not linked.
depends=('gcc-libs' 'glibc' 'libxkbcommon' 'wayland' 'vulkan-icd-loader' 'hicolor-icon-theme')
makedepends=('cargo')
optdepends=('xdg-desktop-portal: native file and print dialogs'
            'cups: printing without a desktop print dialog'
            'xdg-utils: opening links when there is no portal')
# The AUR name `lumen` belongs to another program, which also installs a `lumen` command.
conflicts=('lumen')
source=("lumen-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "lumen-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "lumen-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "lumen-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen
}

package() {
  cd "lumen-$pkgver"
  local id=io.github.imanolgo.Lumen
  install -Dm755 target/release/lumen "$pkgdir/usr/bin/lumen"
  install -Dm644 "data/$id.desktop" "$pkgdir/usr/share/applications/$id.desktop"
  install -Dm644 "data/$id.metainfo.xml" "$pkgdir/usr/share/metainfo/$id.metainfo.xml"
  (cd data/icons && for f in */apps/$id.*; do
    install -Dm644 "$f" "$pkgdir/usr/share/icons/hicolor/$f"
  done)
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
